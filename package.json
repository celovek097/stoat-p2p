{
  "name": "stoat-p2p",
  "version": "0.1.0",
  "description": "Decentralized, peer-to-peer version of the Stoat chat platform. Every user runs a node that speaks the Stoat API.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "stoat-p2p": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "dev": "node --watch src/cli.ts",
    "test": "node --test --test-concurrency=1 \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "build:web": "bash scripts/build-web.sh"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.0"
  }
}
